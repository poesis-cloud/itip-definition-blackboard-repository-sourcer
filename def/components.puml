@startuml components

scale max 4000 width

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A

skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #57606A
skinparam classFontColor #24292F

skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

' Top-to-bottom layout: keeps rendered canvas under PlantUML
' default PLANTUML_LIMIT_SIZE=4096 (left-to-right layout pushed
' the diagram beyond 4096px width and the jebbs.plantuml
' extension reported "No valid diagram found here!").

' ============================================================
' CD - ITIP Definition Blackboard Repository Sourcer
' ============================================================

frame "CD - ITIP Definition Blackboard Repository Sourcer - components" as F1 {

  package "KS contract" as KSAPI <<contract>> {
    abstract class KnowledgeSource <<abstract>> {
      +getFqn() : String
      +getSourceContributionSlots() : Set<ContributionSlot>
      +getTargetContributionSlots() : Set<ContributionSlot>
      +isContributableBlackboard() : boolean
      +contributeToBlackboard() : void
    }
  }

  package "Services (own + encapsulate in-memory context)" as SVC <<service-layer>> {
    class ScipService                 <<service,stateful,in-memory>>
    class CpgService                  <<service,stateful,in-memory>>
    class SbomService                 <<service,stateful,in-memory>>
    class LeidenAlgService            <<service,stateless,algorithm>>
    class MappingService              <<service,stateless,facade>>
    class DefinitionBlackboardService <<service,external>>
    class InferenceService            <<service,external>>
  }

  note right of SVC
    **Service → dependency form (current bootstrap):**
      • (prereq) Repo clone → **JGit** (Maven, in-process)
      • ScipService
          - produce: **scip-java** binary (subprocess, in image);
            add scip-* per language as scope widens
          - parse:   **protobuf-java** + generated `Scip` classes
            (`src/main/proto/scip.proto` compiled by
            `protobuf-maven-plugin`)
      • CpgService     → **cpg-core** + **cpg-language-java**
                          + **cpg-language-jvm** (JVM-only scope)
      • SbomService
          - generate: **syft** binary (subprocess, in image)
          - parse:    **cyclonedx-core-java** (Maven)
      • LeidenAlgService          → **nl.cwts:networkanalysis** (Maven)
      • MappingService            → Jackson (Spring Boot transitive)
      • DefinitionBlackboardService → Spring **RestClient**
                                    + `json-schema-validator`
                                    + `oauth2-client`
      • InferenceService          → **deferred** (no client lib;
                                    will reuse RestClient when wired)
  end note

  package "KSs (produce GSM contributions to the blackboard)" as KS {

    package "Identification KSs (write Definition panel)" as KS_ID {
      class StructureIdentificationKs     <<ks>>
      class MechanismIdentificationKs     <<ks>>
      class DataArchetypeIdentificationKs <<ks>>
      class EffectorIdentificationKs      <<ks>>
      class ReceptorIdentificationKs      <<ks>>
      class InteractionIdentificationKs   <<ks>>
    }

    package "Archetyping KSs (write Archetype panel)" as KS_AR {
      class StructureArchetypingKs       <<ks>>
      class MechanismArchetypingKs       <<ks>>
      class DataArchetypeArchetypingKs   <<ks>>
      class EffectorArchetypingKs        <<ks>>
      class ReceptorArchetypingKs        <<ks>>
      class InteractionArchetypingKs     <<ks>>
    }

    package "Statement KSs (write Statement panel)" as KS_ST {
      class StructureStatementKs         <<ks>>
      class MechanismStatementKs         <<ks>>
      class DataArchetypeStatementKs     <<ks>>
      class EffectorStatementKs          <<ks>>
      class ReceptorStatementKs          <<ks>>
      class InteractionStatementKs       <<ks>>
    }
  }

  ' Every KS IS A KnowledgeSource (extends the abstract contract).
  KnowledgeSource <|-- StructureIdentificationKs
  KnowledgeSource <|-- MechanismIdentificationKs
  KnowledgeSource <|-- DataArchetypeIdentificationKs
  KnowledgeSource <|-- EffectorIdentificationKs
  KnowledgeSource <|-- ReceptorIdentificationKs
  KnowledgeSource <|-- InteractionIdentificationKs
  KnowledgeSource <|-- StructureArchetypingKs
  KnowledgeSource <|-- MechanismArchetypingKs
  KnowledgeSource <|-- DataArchetypeArchetypingKs
  KnowledgeSource <|-- EffectorArchetypingKs
  KnowledgeSource <|-- ReceptorArchetypingKs
  KnowledgeSource <|-- InteractionArchetypingKs
  KnowledgeSource <|-- StructureStatementKs
  KnowledgeSource <|-- MechanismStatementKs
  KnowledgeSource <|-- DataArchetypeStatementKs
  KnowledgeSource <|-- EffectorStatementKs
  KnowledgeSource <|-- ReceptorStatementKs
  KnowledgeSource <|-- InteractionStatementKs

  package "Blackboard (REST; 3 panels, 18 slots)" as BB <<blackboard>> {

    package "Definition panel (candidate identifications)" as PDef {
      class StructureIdentity      <<slot>>
      class MechanismIdentity      <<slot>>
      class DataArchetypeIdentity  <<slot>>
      class EffectorIdentity       <<slot>>
      class ReceptorIdentity       <<slot>>
      class InteractionIdentity    <<slot>>
    }

    package "Archetype panel (archetype matches)" as PArch {
      class StructureArchetype     <<slot>>
      class MechanismArchetype     <<slot>>
      class DataArchetypeArchetype <<slot>>
      class EffectorArchetype      <<slot>>
      class ReceptorArchetype      <<slot>>
      class InteractionArchetype   <<slot>>
    }

    package "Statement panel (draft GSM statements)" as PStmt {
      class StructureStatement     <<slot>>
      class MechanismStatement     <<slot>>
      class DataArchetypeStatement <<slot>>
      class EffectorStatement      <<slot>>
      class ReceptorStatement      <<slot>>
      class InteractionStatement   <<slot>>
    }
  }

  ' Package-level dependencies
  KS  ..> SVC : uses
  SVC ..> BB  : posts contributions

  ' Force vertical stacking of top-level packages to keep
  ' rendered width under PLANTUML_LIMIT_SIZE=4096.
  KSAPI -[hidden]down-> SVC
  SVC   -[hidden]down-> KS
  KS    -[hidden]down-> BB
}

@enduml
