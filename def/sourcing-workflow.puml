@startuml sourcing-workflow

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #57606A
  LifeLineBorderColor #57606A
  GroupBackgroundColor #F6F8FA
  GroupBorderColor #57606A
}
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

title ITIP Definition Blackboard Repository Sourcer - Sourcing workflow\n(aligned to components.puml: KSs depend on Services; Services post contributions to the Blackboard)

' ---- KSs (single representative per stage; the 6 subjects iterate inside each loop) ----
participant "Identification KS\n(<Subject>IdentificationKs)" as KID
participant "Archetyping KS\n(<Subject>ArchetypingKs)" as KAR
participant "Statement KS\n(<Subject>StatementKs)" as KST

' ---- Services (own + encapsulate in-memory context) ----
participant "ScipService\n<<stateful,in-memory>>" as Scip
participant "CpgService\n<<stateful,in-memory>>" as Cpg
participant "SbomService\n<<stateful,in-memory>>" as Sbom
participant "LeidenAlgService\n<<stateless,algorithm>>" as Leiden
participant "MappingService\n<<stateless,facade>>" as Map
participant "InferenceService\n<<external>>" as Inf
participant "DefinitionBlackboardService\n<<external; REST client>>" as DBS

' ---- Substrate ----
participant "Blackboard\n(REST; 3 panels x 18 slots)" as BB

== Blackboard creation + topology declaration ==

DBS -> BB : POST /blackboards (BlackboardConfig)
BB --> DBS : 201 + bbId + ETag

DBS -> BB : POST /blackboards/{bbId}/panels\n  3 panels x 6 slots = 18 slots\n  itip:Definition / itip:Archetype / itip:Statement
BB --> DBS : 200 (topology frozen on first contribution POST)

== Phase 1 - Identification (write Definition panel) ==

loop for each Subject in {Structure, Mechanism, DataArchetype, Effector, Receptor, Interaction}

  KID -> Scip : listSymbols / findOccurrences / ...
  Scip -> Scip : lazy-prime (in-memory, never persisted)
  Scip --> KID : symbols / occurrences

  opt subject needs call/dataflow topology
    KID -> Cpg : callEdges / dataflowEdges
    Cpg -> Cpg : lazy-prime
    Cpg --> KID : edges
  end

  opt Structure subject
    KID -> Leiden : communities(graph, seed, resolution)
    Leiden --> KID : communities
  end

  KID -> Map : mapToArchetype(node)\n  + extractProperties(node, archetype)
  Map --> KID : archetypeUri? + properties

  KID -> KID : embed non-deterministic selection\n  (e.g. Leiden for Structure;\n   taint-reach for Effector/Receptor/Interaction;\n   structural heuristics for Mechanism/DataArchetype)
  KID -> DBS : contributeToBlackboard(\n    panel=itip:Definition,\n    slot=<Subject>Identity,\n    post={subject, evidence[],\n          confidence:{score<1.0, method, factors[]},\n          provenance:{ks@version, indexedRevision,\n                      tools[], ruleSnapshotSha256, seeds[]}})
  DBS -> BB : POST /blackboards/{bbId}/contributions
  BB --> DBS : 201 + contributionId
  DBS --> KID : contributionId

end

== Phase 2 - Archetyping (write Archetype panel) ==

loop for each Subject

  KAR -> DBS : read upstream <Subject>Identity slot
  DBS -> BB : GET /blackboards/{bbId}/state
  BB --> DBS : Identity contributions
  DBS --> KAR : Identity contributions

  KAR -> Map : refine archetype + extractProperties
  Map --> KAR : archetypeUri + properties

  KAR -> DBS : contributeToBlackboard(\n    panel=itip:Archetype,\n    slot=<Subject>Archetype,\n    post={subject, evidence[], confidence, provenance})
  DBS -> BB : POST /blackboards/{bbId}/contributions
  BB --> DBS : 201 + contributionId

end

== Phase 3 - Statement shaping (write Statement panel) ==

loop for each Subject

  KST -> DBS : read upstream <Subject>Archetype slot
  DBS -> BB : GET /blackboards/{bbId}/state
  BB --> DBS : Archetype contributions
  DBS --> KST : Archetype contributions

  alt LLM-driven
    KST -> Inf : completeStatement(archetypeMatch, evidence)
    Inf --> KST : draft (carries inference cacheKey)
  else deterministic
    KST -> Map : extractProperties for draft statement
    Map --> KST : properties
  end

  KST -> DBS : contributeToBlackboard(\n    panel=itip:Statement,\n    slot=<Subject>Statement,\n    post={subject, draftStatement, evidence[],\n          confidence, provenance})
  DBS -> BB : POST /blackboards/{bbId}/contributions
  BB --> DBS : 201 + contributionId

end

note over KID, BB
  Substrate-side validation on every contribution POST:
   * payload conforms to slot.schemaUri
   * confidence.score < 1.0 (core invariant)
   * provenance envelope present
   * blackboard.status == OPEN
  On failure: 422 (schema) or 409 (status). Nothing persisted.
end note

== Seal ==

DBS -> BB : POST /blackboards/{bbId}/seal\n  (If-Match: <ETag>)
BB --> DBS : 200 (status=SEALED, sealTimestamp)

note over DBS, BB
  Post-seal handling (reading the sealed contribution stream,
  client-side reduction, archetype validation, Ascription
  registration into the Definition Manager) is OUT OF SCOPE
  of the components diagram and therefore out of scope of
  this sequence. It is a downstream client concern that
  consumes `GET /blackboards/{bbId}/contributions` from the
  sealed, byte-stable stream.
end note

== Blackboard isolation (no chaining) ==

note over DBS, BB
  Each Blackboard is fully isolated on the substrate side.
  `Contribution.derivedContribution[]` MUST reference
  contributions in the SAME Blackboard (cross-Bb URIs are
  rejected with 422). Cross-Bb lineage (if any) lives in
  client logs.
end note

@enduml
