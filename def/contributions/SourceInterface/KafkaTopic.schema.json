{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/SourceInterface/KafkaTopic/v1",
  "title": "KafkaTopicContribution",
  "description": "A Kafka topic the system produces to or consumes from.",
  "type": "object",
  "required": [
    "topic",
    "role"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "producer",
        "consumer",
        "both"
      ]
    },
    "implementingSymbol": {
      "type": "string",
      "description": "SCIP symbol id of the producer/consumer implementation."
    },
    "valueSchemaRef": {
      "type": "string",
      "description": "Pointer/URI to the message value schema (Avro/JSON Schema/Proto)."
    },
    "keySchemaRef": {
      "type": "string"
    },
    "consumerGroup": {
      "type": "string",
      "description": "For consumers."
    }
  },
  "additionalProperties": false
}
