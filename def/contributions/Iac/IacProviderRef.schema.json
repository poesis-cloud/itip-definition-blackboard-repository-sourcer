{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/Iac/IacProviderRef/v1",
  "title": "IacProviderRefContribution",
  "description": "A declared IaC provider / API surface (Terraform provider block, Pulumi provider, Kubernetes apiVersion). Identifies the cloud / platform target of an IacModule. Pattern-C universal slot (§8bis Rule 2). Producers (Rule 1): `IacScanKS` today.",
  "type": "object",
  "required": [
    "moduleName",
    "iacTool",
    "providerName"
  ],
  "properties": {
    "moduleName": {
      "type": "string",
      "description": "Name of the enclosing IacModule. Pattern-C back-pointer (§8bis Rule 2)."
    },
    "iacTool": {
      "type": "string",
      "description": "Pattern-C discriminator (§8bis Rule 2).",
      "enum": [
        "terraform",
        "helm",
        "kustomize",
        "cloudformation",
        "pulumi",
        "ansible",
        "bicep",
        "cdk",
        "other"
      ]
    },
    "providerName": {
      "type": "string",
      "description": "Provider identifier (aws, azurerm, google, kubernetes, ...)."
    },
    "version": {
      "type": "string",
      "description": "Declared provider version constraint."
    },
    "alias": {
      "type": "string",
      "description": "Provider alias when multiple instances of the same provider are declared."
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "description": "Provider-specific configuration map (region, project, ...)."
    },
    "nativeAttributes": {
      "type": "object",
      "description": "Pattern-C escape hatch (§8bis Rule 2).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
