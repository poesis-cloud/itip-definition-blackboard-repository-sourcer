{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/Iac/IacVariable/v1",
  "title": "IacVariableContribution",
  "description": "An input variable of an IacModule (Terraform variable, Helm values key, Kustomize parameter, CloudFormation parameter). Inputs are part of the module's external contract. Pattern-C universal slot (§8bis Rule 2). Producers (Rule 1): `IacScanKS` today.",
  "type": "object",
  "required": [
    "moduleName",
    "iacTool",
    "name"
  ],
  "properties": {
    "moduleName": {
      "type": "string",
      "description": "Name of the enclosing IacModule. Pattern-C back-pointer (§8bis Rule 2)."
    },
    "iacTool": {
      "type": "string",
      "description": "Pattern-C discriminator (§8bis Rule 2).",
      "enum": [
        "terraform",
        "helm",
        "kustomize",
        "cloudformation",
        "pulumi",
        "ansible",
        "bicep",
        "cdk",
        "other"
      ]
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Declared type (string, number, list(string), object({...}), ...)."
    },
    "description": {
      "type": "string"
    },
    "defaultValue": {
      "description": "Default when declared.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "sensitive": {
      "type": "boolean"
    },
    "required": {
      "type": "boolean"
    },
    "nativeAttributes": {
      "type": "object",
      "description": "Pattern-C escape hatch (§8bis Rule 2). Tool-specific facts (e.g. Terraform `validation` blocks, Helm `@notation` annotations).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
