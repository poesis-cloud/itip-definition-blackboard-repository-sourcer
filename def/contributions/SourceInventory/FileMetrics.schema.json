{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/SourceInventory/FileMetrics/v1",
  "title": "FileMetricsContribution",
  "description": "Static file-level metrics (sizes, line counts, complexity proxies) for a single file.",
  "type": "object",
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "description": "Repo-relative POSIX path."
    },
    "sizeBytes": {
      "type": "integer"
    },
    "linesTotal": {
      "type": "integer"
    },
    "linesCode": {
      "type": "integer"
    },
    "linesComment": {
      "type": "integer"
    },
    "linesBlank": {
      "type": "integer"
    },
    "cyclomaticComplexity": {
      "type": "integer",
      "description": "Optional, when computable."
    },
    "language": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
