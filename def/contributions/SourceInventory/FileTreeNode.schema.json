{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/SourceInventory/FileTreeNode/v1",
  "title": "FileTreeNodeContribution",
  "description": "A node in the repository file tree (file or directory) under the Run's working copy. RepoInventoryKS posts one per discovered path.",
  "type": "object",
  "required": [
    "path",
    "kind"
  ],
  "properties": {
    "path": {
      "type": "string",
      "description": "Repo-relative POSIX path."
    },
    "kind": {
      "type": "string",
      "enum": [
        "file",
        "directory",
        "symlink"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "description": "Size in bytes (files only)."
    },
    "sha1": {
      "type": "string",
      "description": "Content SHA-1 (files only)."
    },
    "executable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
