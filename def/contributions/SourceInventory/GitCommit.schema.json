{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://itip/blackboard/SourceInventory/GitCommit/v1",
  "title": "GitCommitContribution",
  "description": "A git commit pinned by the Run (typically the HEAD ref the working copy was materialised from).",
  "type": "object",
  "required": [
    "sha",
    "ref"
  ],
  "properties": {
    "sha": {
      "type": "string",
      "description": "Full 40-char commit SHA."
    },
    "ref": {
      "type": "string",
      "description": "Branch / tag / explicit ref the Run was anchored to."
    },
    "author": {
      "type": "string"
    },
    "authoredAt": {
      "type": "string",
      "description": "ISO-8601 timestamp."
    },
    "message": {
      "type": "string"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parent commit SHAs."
    }
  },
  "additionalProperties": false
}
