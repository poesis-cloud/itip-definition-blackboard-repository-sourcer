  "annotations": {
    "org/springframework/amqp/rabbit/annotation/RabbitListener#": {
      "summary": "Annotation that marks a method to be the target of a Rabbit message listener on the specified queues (or bindings).",
      "targets": [ "TYPE", "METHOD", "ANNOTATION_TYPE" ],
      "retention": "RUNTIME",
      "documented": true,
      "repeatable": true,
      "attributes": {
        "id": {
          "summary": "The unique identifier of the container managing for this endpoint.",
          "type": "java.lang.String",
          "default": ""
        },
        "containerFactory": {
          "summary": "The bean name of the RabbitListenerContainerFactory to use.",
          "type": "java.lang.String",
          "default": ""
        },
        "queues": {
          "summary": "The queues for this listener. Mutually exclusive with queuesToDeclare and bindings.",
          "type": "java.lang.String[]",
          "default": [ ]
        },
        "queuesToDeclare": {
          "summary": "The queues to declare for this listener.",
          "type": "org.springframework.amqp.rabbit.annotation.Queue[]",
          "default": [ ]
        },
        "exclusive": {
          "type": "boolean",
          "default": false
        },
        "priority": {
          "type": "java.lang.String",
          "default": ""
        },
        "admin": {
          "type": "java.lang.String",
          "default": ""
        },
        "bindings": {
          "summary": "Array of QueueBinding (queue + exchange + routing key) declarations.",
          "type": "org.springframework.amqp.rabbit.annotation.QueueBinding[]",
          "default": [ ]
        },
        "group": {
          "type": "java.lang.String",
          "default": ""
        },
        "returnExceptions": {
          "type": "java.lang.String",
          "default": ""
        },
        "errorHandler": {
          "type": "java.lang.String",
          "default": ""
        },
        "concurrency": {
          "type": "java.lang.String",
          "default": ""
        },
        "autoStartup": {
          "type": "java.lang.String",
          "default": ""
        },
        "messageConverter": {
          "type": "java.lang.String",
          "default": ""
        },
        "ackMode": {
          "type": "java.lang.String",
          "default": ""
        }
      }
    },
    "org/springframework/amqp/rabbit/annotation/RabbitListeners#": {
      "summary": "Container annotation that aggregates several @RabbitListener annotations.",
      "targets": [ "TYPE", "METHOD", "ANNOTATION_TYPE" ],
      "retention": "RUNTIME",
      "documented": true,
      "attributes": {
        "value": {
          "type": "org.springframework.amqp.rabbit.annotation.RabbitListener[]",
          "default": null
        }
      }
    },
    "org/springframework/amqp/rabbit/annotation/RabbitHandler#": {
      "summary": "Annotation that marks a method to be the target of a Rabbit message listener within a class that is annotated with @RabbitListener.",
      "targets": [ "METHOD" ],
      "retention": "RUNTIME",
      "documented": true,
      "attributes": {
        "isDefault": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "org/springframework/amqp/rabbit/annotation/EnableRabbit#": {
      "summary": "Enable Rabbit listener annotated endpoints created under the cover by a RabbitListenerContainerFactory.",
      "targets": [ "TYPE" ],
      "retention": "RUNTIME",
      "documented": true
    }
  },
