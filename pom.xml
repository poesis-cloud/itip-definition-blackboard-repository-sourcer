<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.13</version>
    <relativePath/>
  </parent>

  <groupId>cloud.poesis.itip</groupId>
  <artifactId>itip-definition-blackboard-repository-sourcer</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>itip-definition-blackboard-repository-sourcer</name>
  <description>ITIP Definition Blackboard Repository Sourcer — client sourcer that turns a code repository into GSM contributions posted to a Definition Blackboard.</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.9</version>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.16</version>
    </dependency>

    <!-- Service-layer integrations (see def/components.puml) -->

    <!-- Repository pull (prereq for every KS): pure-Java git via JGit.
         Avoids requiring a system `git` binary in the runtime image. -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>7.6.0.202603022253-r</version>
    </dependency>

    <!-- SCIP index parsing (ScipService): wire format is protobuf.
         The vendored scip.proto under src/main/proto/ is compiled to Java
         classes by protobuf-maven-plugin (see <build>). protobuf-java is the
         runtime those generated classes link against.
         NOTE: index *production* requires per-language scip-* binaries
         (subprocess); see Dockerfile. No Maven dep can replace that step. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>3.25.5</version>
    </dependency>

    <!-- Code Property Graph (CpgService): Fraunhofer AISEC CPG engine
         + JVM frontends (matching the initial JVM-only sourcing scope).
         Add cpg-language-{python,go,typescript,cxx,...} when the supported
         language set widens. -->
    <dependency>
      <groupId>de.fraunhofer.aisec</groupId>
      <artifactId>cpg-core</artifactId>
      <version>10.8.2</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.aisec</groupId>
      <artifactId>cpg-language-java</artifactId>
      <version>10.8.2</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.aisec</groupId>
      <artifactId>cpg-language-jvm</artifactId>
      <version>10.8.2</version>
    </dependency>

    <!-- Leiden community detection (LeidenAlgService): CWTS reference Java
         implementation by the Leiden algorithm authors (Traag et al.). -->
    <dependency>
      <groupId>nl.cwts</groupId>
      <artifactId>networkanalysis</artifactId>
      <version>1.3.0</version>
    </dependency>

    <!-- SBOM ingestion (SbomService): CycloneDX object model.
         NOTE: SBOM *generation* from a cloned repo is performed by the
         `syft` binary (subprocess); see Dockerfile. -->
    <dependency>
      <groupId>org.cyclonedx</groupId>
      <artifactId>cyclonedx-core-java</artifactId>
      <version>9.0.5</version>
    </dependency>

    <!-- InferenceService (LLM): no client library at bootstrap. Most LLM
         APIs are plain HTTPS/JSON; will reuse Spring RestClient when wired. -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- Detects OS classifier so protobuf-maven-plugin can fetch the
           matching protoc binary from Maven Central. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>def/contributions</directory>
        <targetPath>contributions</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Compiles src/main/proto/*.proto to Java classes during
           generate-sources. Generated code lands in
           target/generated-sources/protobuf/java/ and is excluded from JaCoCo. -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:3.25.5:exe:${os.detected.classifier}</protocArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <!-- Generated protobuf classes from scip.proto. -->
                <exclude>cloud/poesis/itip/sourcer/scip/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <exclude>cloud/poesis/itip/sourcer/scip/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.1</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>enforce</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.35.0</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <json>
            <includes>
              <include>src/**/*.json</include>
              <include>def/**/*.json</include>
            </includes>
            <jackson/>
          </json>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>target/**</exclude>
              <exclude>ops/helm/templates/**</exclude>
            </excludes>
            <prettier>
              <prettierVersion>3.3.3</prettierVersion>
            </prettier>
          </yaml>
          <formats>
            <format>
              <includes>
                <include>**/*.md</include>
              </includes>
              <excludes>
                <exclude>target/**</exclude>
              </excludes>
              <prettier>
                <prettierVersion>3.3.3</prettierVersion>
              </prettier>
            </format>
          </formats>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.9.8.2</version>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
